# 仅基础设施配置
COMPOSE_PROJECT_NAME=metasfresh-infra
mfregistry=metasfresh
mfversion=local

# 数据库类型
dbqualifier=preloaded

# 端口映射（基础设施）
DB_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
ES_PORT=9200
ES_TRANSPORT_PORT=9300

# ES JVM 配置
ES_JAVA_OPTS=-Xms256M -Xmx512m

# 数据持久化目录
DATA_DIR=./data/infra
